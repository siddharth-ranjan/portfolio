{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "bom1"
  ],
  "redirects": [
    {
      "source": "/resume",
      "destination": "/#resume",
      "permanent": false
    },
    {
      "source": "/image",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/chess",
      "destination": "/chess.html"
    }
  ],
  "headers": [
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/:icon(favicon-32.png|apple-touch-icon.png|chess-icon.svg|chess-favicon-32.png|chess-apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
